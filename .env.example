# ==============================================================================
# SKRULLA! Environment Configuration
# Copy this file to `.env` and fill in your values.
# ==============================================================================

# Google Gemini API Key (Required for live AI persona feed generation and interactive Q&A)
# Get your free key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# App ID for scoping Firestore database records (defaults to skrulla-study-app)
VITE_APP_ID=skrulla-study-app

# Gemini Model Variant (e.g. gemini-1.5-flash, gemini-2.5-flash)
VITE_GEMINI_MODEL=gemini-1.5-flash

# Optional: Custom Logo URL (image link to override default logo)
VITE_CUSTOM_LOGO_URL=

# Optional: Firebase Web App Configuration (JSON string)
# If omitted, SKRULLA! seamlessly operates in offline LocalStorage mode!
# Example:
# VITE_FIREBASE_CONFIG={"apiKey":"AIza...","authDomain":"skrulla.firebaseapp.com","projectId":"skrulla-app","storageBucket":"skrulla.appspot.com","messagingSenderId":"123456789","appId":"1:123456789:web:abcdef"}
VITE_FIREBASE_CONFIG=
